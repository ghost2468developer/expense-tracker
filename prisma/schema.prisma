// Prisma schema for My Rand Tracker.
// Run `npx prisma db push` to sync this with the database, and
// `npx prisma generate` to (re)build the type-safe client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id         Int      @id @default(autoincrement())
  type       String // "income" | "expense"
  title      String
  category   String
  amount     Decimal  @db.Decimal(12, 2)
  occurredOn DateTime @map("occurred_on") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([type])
  @@index([occurredOn])
  @@map("transactions")
}
